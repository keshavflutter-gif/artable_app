<?xml version="1.0" encoding="utf-8"?>
<!--
    Window background for the image_cropper (uCrop) crop screen.
    On Android 15+/16 the window is edge-to-edge, so with fitsSystemWindows the
    status-bar strip at the top and the nav-bar strip at the bottom show this
    background. Purple on top blends into the uCrop toolbar; white at the bottom
    blends into the uCrop controls bar.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ucrop_app_toolbar" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="200dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ucrop_app_controls" />
        </shape>
    </item>
</layer-list>
